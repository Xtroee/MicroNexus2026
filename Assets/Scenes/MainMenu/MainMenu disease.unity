  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Pharyngitis is an acute infection of the oropharynx or nasopharynx. It
    is responsible for 6% of visits by children to their primary care provider annually.
    Although viral causes are most common, group A \u03B2-hemolytic Streptococcus
    (GABHS, also known as S. pyogenes) is the primary bacterial cause pharyngitis
    due to GABHS is commonly known as \u201Cstrep throat\u201D.\r\n\r\nViruses cause
    the majority of acute pharyngitis cases. GABHS (Group A Beta-Hemolytic Streptococcus)
    is the most common (10%-30% of persons of all ages with pharyngitis) and is the
    only commonly occurring form of acute pharyngitis for which antibiotic\r\ntherapy
    is indicated.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3914de223fa8efc4787902589e5d6968, type: 2}
  m_sharedMaterial: {fileID: 4947494457033249829, guid: 3914de223fa8efc4787902589e5d6968, type: 2}
