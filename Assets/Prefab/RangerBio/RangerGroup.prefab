  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<b>Neisseria gonorrhoeae (Gram-negative)</b>



    <b>Brief Characteristics:</b>



    -
    Gram-negative diplococci ("coffee bean" shape)



    - Intracellular inside
    neutrophils



    - No capsule



    <b>Habitat:</b>



    - Mucosal surfaces
    of the urogenital tract, rectum and pharynx



    <b>Major Diseases:</b>



    -
    Gonorrhea (urethritis, cervicitis)



    - Pharyngeal and rectal gonorrhea



    -
    Disseminated gonococcal infection



    - Pelvic inflammatory disease



    <b>Effective
    Antibiotics:</b>



    - Ceftriaxone (single IM dose, CDC first-line)



    -
    Cefixime (oral alternative)



'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3914de223fa8efc4787902589e5d6968, type: 2}
