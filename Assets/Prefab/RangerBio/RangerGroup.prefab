  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Class:</b> \u03B2-lactam antibiotic; aminopenicillin\r\n\r\n<b>Indications:</b>\r\nTreatment
    of acute otitis media, pharyngitis and tonsillitis, lower respiratory tract infections,
    skin and skin structure infections, urinary tract infections, acute uncomplicated
    gonorrhea, typhoid fever, Helicobacter pylori infection, and duodenal ulcer disease
    (as part of combination therapy)\r\n\r\n<b>Target Bacteria:</b>\r\nStreptococcus
    pneumoniae, Streptococcus pyogenes, Enterococcus faecalis, Haemophilus influenzae,
    Escherichia coli, Helicobacter pylori\r\n\r\n<b>Adverse Drug Reactions (ADR):</b>\r\nNausea,
    vomiting, diarrhea, skin rash, hypersensitivity reactions, including anaphylaxis
    (rare)\r\n\r\n<b>LINK:</b>\r\n<link=\"https://www.rxlist.com/amoxicillin/generic-drug.htm\">Click
    here to see more</link>\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3914de223fa8efc4787902589e5d6968, type: 2}
