    m_PersistentCalls:
      m_Calls: []
  m_text: '<b>Class:</b> Fluoroquinolone antibiotic (third generation)





    <b>Indications:</b>

    Treatment
    of community-acquired pneumonia, acute bacterial sinusitis, acute exacerbations
    of chronic bronchitis, urinary tract infections, and skin and soft tissue infections





    <b>Target
    Bacteria:</b>

    Streptococcus pneumoniae, Haemophilus influenzae, Escherichia
    coli, Klebsiella pneumoniae, Legionella pneumophila





    <b>Adverse Drug
    Reactions (ADR):</b>

    Gastrointestinal disturbances, dizziness, insomnia,
    QT interval prolongation, increased risk of tendon rupture





    <b>LINK:</b>

    <link="https://www.rxlist.com/levaquin-drug.htm">Click
    here to see more</link>

'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3914de223fa8efc4787902589e5d6968, type: 2}
  m_sharedMaterial: {fileID: 4947494457033249829, guid: 3914de223fa8efc4787902589e5d6968, type: 2}
