  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Streptococcus pyogenes \u2013 Group A Strep / GABHS (Gram-positive)</b>\r\n\r\n<b>Brief
    Characteristics:</b>\r\n\r\n- Cocci in chains\r\n\r\n- Beta-hemolytic\r\n\r\n-
    Many virulence factors (M protein, streptolysin)\r\n\r\n<b>Habitat:</b>\r\n\r\n-
    Nasopharynx\r\n\r\n- Skin\r\n\r\n<b>Major Diseases:</b>\r\n\r\n- Strep throat\r\n\r\n-
    Scarlet fever\r\n\r\n- Impetigo\r\n\r\n- Cellulitis\r\n\r\n- Necrotizing fasciitis\r\n\r\n-
    Post-infection rheumatic fever and glomerulonephritis\r\n\r\n<b>Effective Antibiotics:</b>\r\n\r\n-
    Penicillin V (first-line, GABHS remains universally susceptible)\r\n\r\n- Amoxicillin
    (equally effective alternative)\r\n\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3914de223fa8efc4787902589e5d6968, type: 2}
