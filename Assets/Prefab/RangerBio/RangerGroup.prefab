  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>MSSA \u2013 Methicillin-Sensitive Staphylococcus aureus (Gram-positive)</b>\r\n\r\n<b>Brief
    Characteristics:</b>\r\n\r\n- Gram-positive cocci\r\n\r\n- Cluster-forming cocci
    (grape-like appearance)\r\n\r\n- Coagulase-positive\r\n\r\n<b>Habitat:</b>\r\n\r\n-
    Skin\r\n\r\n- Nasal mucosa (anterior nares)\r\n\r\n<b>Major Diseases:</b>\r\n\r\n-
    Skin and soft tissue infections (abscesses, cellulitis)\r\n\r\n- Pneumonia\r\n\r\n-
    Osteomyelitis\r\n\r\n- Endocarditis\r\n\r\n- Sepsis\r\n\r\n<b>Effective Antibiotics:</b>\r\n\r\n-
    Cefazolin\r\n\r\n- Oxacillin / Nafcillin\r\n\r\n- Amoxicillin\u2013clavulanate\r\n\r\n-
    Clindamycin\r\n\r\n- Levofloxacin\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3914de223fa8efc4787902589e5d6968, type: 2}
