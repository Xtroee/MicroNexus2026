      m_Calls: []
  m_text: "<b>Class:</b> \u03B2-lactam antibiotic; carbapenem (broad-spectrum)\r\n\r\n<b>Indications:</b>\r\nSevere
    or complicated infections including nosocomial pneumonia, complicated intra-abdominal
    infections, complicated urinary tract infections, bacterial meningitis, and infections
    caused by ESBL/MDR Gram-negative organisms\r\n\r\n<b>Target Bacteria:</b>\r\nKlebsiella
    pneumoniae (ESBL), Escherichia coli (ESBL), Pseudomonas aeruginosa, Haemophilus
    influenzae, Streptococcus pneumoniae, Enterobacterales\r\n\r\n<b>Adverse Drug
    Reactions (ADR):</b>\r\nNausea, vomiting, diarrhea, headache, injection-site
    reactions, seizures (rare, dose-related), hypersensitivity reactions\r\n\r\n<b>LINK:</b>\r\n<link=\"https://www.rxlist.com/merrem-drug.htm\">Click
    here to see more</link>\r\n"
  m_isRightToLeft: 0
