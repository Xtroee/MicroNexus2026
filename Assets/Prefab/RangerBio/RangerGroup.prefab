  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Streptococcus pneumonia is known in the game world as a silent invader
    that strikes when defenses grow weak. It drifts through the air unnoticed, settling
    deep within the lungs where it multiplies rapidly and clouds the battlefield
    with infection. Once ignored, it spreads beyond its first foothold, triggering
    fever, breathlessness, and confusion as it drains the host\u2019s strength from
    within. Clever and resilient, this enemy thrives on vulnerability, turning a
    moment of neglect into a full-scale assault, reminding players that even the
    smallest unseen foe can become a devastating threat if left unchecked."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3914de223fa8efc4787902589e5d6968, type: 2}
  m_sharedMaterial: {fileID: 4947494457033249829, guid: 3914de223fa8efc4787902589e5d6968, type: 2}
