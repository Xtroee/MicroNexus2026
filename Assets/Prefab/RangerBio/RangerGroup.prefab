  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Streptococcus pneumoniae (Gram-positive)</b>\r\n\r\n<b>Brief Characteristics:</b>\r\n\r\n-
    Diplococci\r\n\r\n- Encapsulated\r\n\r\n- Alpha-hemolytic\r\n\r\n<b>Habitat:</b>\r\n\r\n-
    Normal flora of the nasopharynx\r\n\r\n<b>Major Diseases:</b>\r\n\r\n- Community-acquired
    pneumonia (CAP)\r\n\r\n- Otitis media\r\n\r\n- Sinusitis\r\n\r\n- Meningitis\r\n\r\n-
    Bacteremia\r\n\r\n<b>Effective Antibiotics:</b>\r\n\r\n- Amoxicillin / Amoxicillin\u2013clavulanate\r\n\r\n-
    Penicillin (if susceptible)\r\n\r\n- Ceftriaxone / Cefotaxime\r\n\r\n- Levofloxacin\r\n\r\n-
    Azithromycin (increasing resistance)\r\n\r\n- Vancomycin (severe or resistant
    cases)\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3914de223fa8efc4787902589e5d6968, type: 2}
