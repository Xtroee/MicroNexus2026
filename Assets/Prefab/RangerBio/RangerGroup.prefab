  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<b>Helicobacter pylori (Gram-negative)</b>



    <b>Brief Characteristics:</b>



    -
    Spiral (helical) rod



    - Motile with flagella



    - Produces urease to
    survive stomach acid



    <b>Habitat:</b>



    - Gastric mucosa



    <b>Major
    Diseases:</b>



    - Chronic gastritis



    - Gastric and duodenal ulcers



    -
    MALT lymphoma



    - Risk factor for gastric cancer



    <b>Effective Antibiotics:</b>



    -
    Clarithromycin + Amoxicillin (standard triple therapy with a PPI)



    - Levofloxacin
    (salvage regimen)



'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3914de223fa8efc4787902589e5d6968, type: 2}
