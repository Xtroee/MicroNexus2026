  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<b>Class:</b> Macrolide antibiotic



    <b>Indications:</b>

    Respiratory
    tract infections, skin infections, combination therapy (with a PPI + Amoxicillin)
    to eradicate Helicobacter pylori



    <b>Target Bacteria:</b>

    Helicobacter
    pylori, Streptococcus pneumoniae, Haemophilus influenzae, Moraxella catarrhalis,
    Mycobacterium avium complex



    <b>Adverse Drug Reactions (ADR):</b>

    Gastrointestinal
    disturbances (a metallic taste is common), QT interval prolongation, drug interactions
    (CYP3A4 inhibitor), hepatotoxicity (rare)



    <b>LINK:</b>

    <link="https://www.rxlist.com/biaxin-drug.htm">Click
    here to see more</link>

'
