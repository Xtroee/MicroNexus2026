  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Acinetobacter baumannii \u2013 CRAB (Gram-negative)</b>\r\n\r\n<b>Brief
    Characteristics:</b>\r\n\r\n- Coccobacillus\r\n\r\n- Survives for weeks on dry
    surfaces\r\n\r\n- Carbapenem-resistant strains are the WHO critical priority
    pathogen #1 (2024)\r\n\r\n<b>Habitat:</b>\r\n\r\n- Hospital environment (ventilators,
    medical devices, surfaces)\r\n\r\n- Water\r\n\r\n<b>Major Diseases:</b>\r\n\r\n-
    Ventilator-associated pneumonia\r\n\r\n- Bacteremia\r\n\r\n- Wound infections
    (especially war and trauma wounds)\r\n\r\n- Device-associated meningitis\r\n\r\n<b>Effective
    Antibiotics:</b>\r\n\r\n- Colistin (last-line drug)\r\n\r\n- Ampicillin\u2013sulbactam
    (certain susceptible strains)\r\n\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3914de223fa8efc4787902589e5d6968, type: 2}
