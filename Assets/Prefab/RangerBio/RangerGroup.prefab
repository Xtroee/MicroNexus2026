  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Klebsiella pneumoniae \u2013 ESBL-producing (Gram-negative)</b>\r\n\r\n<b>Brief
    Characteristics:</b>\r\n\r\n- Encapsulated rod\r\n\r\n- Non-motile\r\n\r\n- Produces
    Extended-Spectrum Beta-Lactamase (ESBL) that inactivates most penicillins and
    cephalosporins\r\n\r\n<b>Habitat:</b>\r\n\r\n- Normal gut flora\r\n\r\n- Hospital
    environment (ventilators, catheters)\r\n\r\n<b>Major Diseases:</b>\r\n\r\n- Nosocomial
    pneumonia\r\n\r\n- Urinary tract infection\r\n\r\n- Bacteremia\r\n\r\n- Liver
    abscess\r\n\r\n<b>Effective Antibiotics:</b>\r\n\r\n- Meropenem (carbapenem,
    first-line for ESBL strains)\r\n\r\n- Colistin (if carbapenem-resistant)\r\n\r\n-
    Amikacin (certain cases)\r\n\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3914de223fa8efc4787902589e5d6968, type: 2}
  m_sharedMaterial: {fileID: 4947494457033249829, guid: 3914de223fa8efc4787902589e5d6968, type: 2}
