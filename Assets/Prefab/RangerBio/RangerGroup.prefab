  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Class:</b> \u03B2-lactam antibiotic; natural penicillin (narrow spectrum)\r\n\r\n<b>Indications:</b>\r\nStreptococcal
    pharyngitis (\"strep throat\"), prophylaxis against recurrence of rheumatic fever,
    mild skin infections caused by susceptible streptococci\r\n\r\n<b>Target Bacteria:</b>\r\nStreptococcus
    pyogenes (Group A Streptococcus), Streptococcus pneumoniae (susceptible strains)\r\n\r\n<b>Adverse
    Drug Reactions (ADR):</b>\r\nNausea, diarrhea, skin rash, hypersensitivity reactions
    including anaphylaxis (rare but serious)\r\n\r\n<b>LINK:</b>\r\n<link=\"https://www.rxlist.com/penicillin-vk-drug.htm\">Click
    here to see more</link>\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3914de223fa8efc4787902589e5d6968, type: 2}
