  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<b>Class:</b>

    Fluoroquinolone antibiotic (second generation)





    <b>Indications:</b>

    Treatment
    of urinary tract infections, gastrointestinal infections, bone and joint infections,
    skin and soft tissue infections, Gram-negative pneumonia, and anthrax





    <b>Target
    Bacteria:</b>

    Escherichia coli, Pseudomonas aeruginosa, Klebsiella spp.,
    Salmonella spp., Shigella spp.





    <b>Adverse Drug Reactions (ADR):</b>

    Nausea,
    diarrhea, dizziness, photosensitivity, increased risk of tendonitis and tendon
    rupture





    <b>LINK:</b>

    <link="https://www.rxlist.com/cipro-drug.htm">Click
    here to see more</link>

'
