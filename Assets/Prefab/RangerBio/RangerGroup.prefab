  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>MRSA \u2013 Methicillin-Resistant Staphylococcus aureus (Gram-positive)</b>\r\n\r\n<b>Brief
    Characteristics:</b>\r\n\r\n- Gram-positive cocci\r\n\r\n- Cluster-forming cocci
    (grape-like appearance)\r\n\r\n- Resistant to \u03B2-lactam antibiotics\r\n\r\n-
    Similar morphology to MSSA\r\n\r\n<b>Habitat:</b>\r\n\r\n- Skin\r\n\r\n- Hospitals
    (HA-MRSA)\r\n\r\n- Community settings (CA-MRSA)\r\n\r\n<b>Major Diseases:</b>\r\n\r\n-
    Skin abscesses\r\n\r\n- Severe pneumonia\r\n\r\n- Endocarditis\r\n\r\n- Sepsis\r\n\r\n<b>Effective
    Antibiotics:</b>\r\n\r\n- Vancomycin (gold standard)\r\n\r\n- Linezolid\r\n\r\n-
    Daptomycin (not for pneumonia)\r\n\r\n- Clindamycin (if susceptible)\r\n\r\n-
    Trimethoprim\u2013sulfamethoxazole (mild infections)\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3914de223fa8efc4787902589e5d6968, type: 2}
  m_sharedMaterial: {fileID: 4947494457033249829, guid: 3914de223fa8efc4787902589e5d6968, type: 2}
