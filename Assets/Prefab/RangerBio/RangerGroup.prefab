  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Class:</b> \u03B2-lactam antibiotic; third-generation cephalosporin
    (injectable)\r\n\r\n<b>Indications:</b>\r\nGonorrhea, bacterial meningitis, community-acquired
    and nosocomial pneumonia, complicated urinary tract infections, septicemia, skin
    and soft tissue infections\r\n\r\n<b>Target Bacteria:</b>\r\nNeisseria gonorrhoeae,
    Streptococcus pneumoniae, Haemophilus influenzae, Moraxella catarrhalis, Escherichia
    coli, Streptococcus pyogenes\r\n\r\n<b>Adverse Drug Reactions (ADR):</b>\r\nDiarrhea,
    nausea, pain at the injection site, biliary sludge (pseudolithiasis), hypersensitivity
    reactions\r\n\r\n<b>LINK:</b>\r\n<link=\"https://www.rxlist.com/rocephin-drug.htm\">Click
    here to see more</link>\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3914de223fa8efc4787902589e5d6968, type: 2}
