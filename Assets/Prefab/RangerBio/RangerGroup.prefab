  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Haemophilus influenzae (Gram-negative)</b>\r\n\r\n<b>Brief Characteristics:</b>\r\n\r\n-
    Coccobacilli\r\n\r\n- Requires factor X and V\r\n\r\n- Type b is the most virulent\r\n\r\n<b>Habitat:</b>\r\n\r\n-
    Nasopharynx\r\n\r\n<b>Major Diseases:</b>\r\n\r\n- Pneumonia\r\n\r\n- Epiglottitis\r\n\r\n-
    Otitis media\r\n\r\n- Sinusitis\r\n\r\n- Meningitis (type b)\r\n\r\n<b>Effective
    Antibiotics:</b>\r\n\r\n- Amoxicillin\u2013clavulanate\r\n\r\n- Ceftriaxone /
    Cefotaxime\r\n\r\n- Azithromycin\r\n\r\n- Levofloxacin\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3914de223fa8efc4787902589e5d6968, type: 2}
