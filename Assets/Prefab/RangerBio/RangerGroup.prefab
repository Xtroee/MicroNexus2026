  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Enterococcus faecium \u2013 VRE (Gram-positive)</b>\r\n\r\n<b>Brief
    Characteristics:</b>\r\n\r\n- Cocci in pairs or short chains\r\n\r\n- Extremely
    tolerant of harsh environments\r\n\r\n- vanA/vanB genes make it vancomycin-resistant\r\n\r\n<b>Habitat:</b>\r\n\r\n-
    Normal gut flora\r\n\r\n- Persists on hospital surfaces and equipment\r\n\r\n<b>Major
    Diseases:</b>\r\n\r\n- Bacteremia\r\n\r\n- Catheter-associated urinary tract
    infection\r\n\r\n- Endocarditis\r\n\r\n- Intra-abdominal infection (usually in
    hospitalized or immunocompromised patients)\r\n\r\n<b>Effective Antibiotics:</b>\r\n\r\n-
    Linezolid (first-line, FDA-approved for VRE)\r\n\r\n- Daptomycin (not for pneumonia)\r\n\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3914de223fa8efc4787902589e5d6968, type: 2}
  m_sharedMaterial: {fileID: 4947494457033249829, guid: 3914de223fa8efc4787902589e5d6968, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
  m_fontColor32:
