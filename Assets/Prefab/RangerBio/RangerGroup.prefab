      m_Calls: []
  m_text: "<b>Escherichia coli (Gram-negative)</b>\r\n\r\n<b>Brief Characteristics:</b>\r\n\r\n-
    Gram-negative bacilli\r\n\r\n- Facultative anaerobe\r\n\r\n<b>Habitat:</b>\r\n\r\n-
    Normal intestinal flora\r\n\r\n<b>Major Diseases:</b>\r\n\r\n- Urinary tract
    infections (UTIs)\r\n\r\n- Sepsis\r\n\r\n- Diarrhea\r\n\r\n- Neonatal meningitis\r\n\r\n-
    Intra-abdominal infections\r\n\r\n<b>Effective Antibiotics:</b>\r\n\r\n- Ceftriaxone\r\n\r\n-
    Cefixime\r\n\r\n- Ciprofloxacin\r\n\r\n- Levofloxacin\r\n\r\n- Trimethoprim\u2013sulfamethoxazole\r\n\r\n-
    Carbapenems (for ESBL-producing strains)\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3914de223fa8efc4787902589e5d6968, type: 2}
