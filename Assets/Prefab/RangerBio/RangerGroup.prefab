  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Chlamydia trachomatis (obligate intracellular)</b>\r\n\r\n<b>Brief
    Characteristics:</b>\r\n\r\n- Obligate intracellular bacterium (cannot replicate
    outside host cells)\r\n\r\n- No classic peptidoglycan wall\r\n\r\n- Two forms
    (elementary body / reticulate body)\r\n\r\n<b>Habitat:</b>\r\n\r\n- Columnar
    epithelial cells of the urogenital tract, conjunctiva and rectum\r\n\r\n<b>Major
    Diseases:</b>\r\n\r\n- Chlamydia (urethritis, cervicitis \u2013 often without
    symptoms)\r\n\r\n- Pelvic inflammatory disease\r\n\r\n- Infertility\r\n\r\n-
    Trachoma (ocular, endemic regions)\r\n\r\n- Neonatal conjunctivitis and pneumonia\r\n\r\n<b>Effective
    Antibiotics:</b>\r\n\r\n- Doxycycline (first-line, CDC since 2021)\r\n\r\n- Azithromycin
    (alternative, e.g. in pregnancy)\r\n\r\n"
  m_isRightToLeft: 0
