  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Class:</b>\r\nCombination antibiotic; folate synthesis inhibitor\r\n\r\n<b>Indications:</b>\r\nTreatment
    of urinary tract infections, bacterial diarrhea, Pneumocystis jirovecii pneumonia,
    skin and soft tissue infections, and toxoplasmosis\r\n\r\n<b>Target Bacteria:</b>\r\nEscherichia
    coli, Klebsiella spp., Staphylococcus aureus, Pneumocystis jirovecii, Toxoplasma
    gondii\r\n\r\n<b>Adverse Drug Reactions (ADR):</b>\r\nNausea, vomiting, skin
    rash, Stevens\u2013Johnson syndrome, bone marrow suppression\r\n\r\n<b>LINK:</b>\r\n<link=\"https://www.rxlist.com/bactrim-drug.htm\">Click
    here to see more</link>\r\n"
