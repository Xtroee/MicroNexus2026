  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<b>Class:</b> Glycopeptide antibiotic



    <b>Indications:</b>

    Treatment
    of serious Gram-positive bacterial infections, including methicillin-resistant
    Staphylococcus aureus (MRSA), endocarditis, pneumonia, bone and joint infections,
    and Clostridioides difficile-associated colitis



    <b>Target Bacteria:</b>

    Staphylococcus
    aureus (including MRSA), Streptococcus spp., Enterococcus spp., Clostridioides
    difficile



    <b>Adverse Drug Reactions (ADR):</b>

    Nephrotoxicity, ototoxicity,
    infusion-related reactions (red man syndrome), phlebitis, skin rash



    <b>LINK:</b>

    <link="https://www.rxlist.com/vancocin-drug.htm">Click
    here to see more</link>

'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3914de223fa8efc4787902589e5d6968, type: 2}
